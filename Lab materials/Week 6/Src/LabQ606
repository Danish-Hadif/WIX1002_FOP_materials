public class Lab06Q6 {
    public static boolean isPrime(int n){
        if(n <=1){
            return false;
        }
        for(int i = 2; i<Math.sqrt(n);i++){
            if(n%i==0){
                return false;
            }
        }
        return true;
        
    }
    public static int reversed(int n){
        int reversed = 0;
        while(n != 0){
            int digit = n%10;
            reversed = reversed * 10 + digit;
            n /= 10;
        }
        return reversed;
    }
    public static boolean isPalindromicPrime(int n){
        return isPrime(n)&&(n == reversed(n));
    }
    public static boolean isEmrip(int n){
        return isPrime(n) && isPrime(reversed(n)) && (n != reversed(n));
    }
    public static void main(String[] args) {
        System.out.println("The first 20 palindromic primes are:");
        int count = 0;
        int num = 2;
        int[] arr= new int[20];
        while(count <20){
            if(isPalindromicPrime(num)){
                arr[count] = num;
                count++;
                
            }
            num++;
        }
        System.out.println("\n");
        System.out.println("The first 20 palindromic primes stored in the array:");
        for(int i =0; i<arr.length;i++){
            System.out.print(arr[i]+" ");
        }
        System.out.println();
    }
    
}

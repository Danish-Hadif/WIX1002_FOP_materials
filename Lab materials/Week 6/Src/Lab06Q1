public class Lab06Q1 {
    public static int trangular(int n){
        int sum =0;
        for(int i = 1; i<=n;i++){
            sum += n;
            
        }
        return sum;
        
    }
    public static void main(String[] args) {
        System.out.println("The first 20 triangular numbers are: ");
        for(int i =1;i<=20;i++){
            int triNum = trangular(i);
            System.out.print("T(" + i + ") = " + triNum+" ");
        }
        System.out.println();
    }
    
}

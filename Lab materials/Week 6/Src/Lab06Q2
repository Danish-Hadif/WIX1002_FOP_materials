package week.pkg6;

/**
 *
 * @author danishhadif
 */
public class Lab06Q2 {
    public static void multiPrint(int n, char c){
        for(int i =1; i<=n;i++){
            System.out.print(c);
        }
    }
    public static void main(String[] args) {
        int height = 5;
        System.out.println("----- Triangle Pattern -----");
        for(int i=1;i<=height;i++){
            multiPrint(i, '*');
            System.out.println();
        }
        System.out.println("----- Diamond Pattern -----");
        int n = 4;
        // Top half of the diamond (including the middle widest row)
        for(int i = 1; i<=n;i++){
            multiPrint(n - i, ' ');     // Prints leading spaces for centering
            multiPrint(2 * i - 1, '*'); // Prints odd number of stars (1, 3, 5, 7...)
            System.out.println();
        }
        // Bottom half of the diamond
        for (int i = n - 1; i >= 1; i--) {
            multiPrint(n - i, ' ');     // Prints leading spaces
            multiPrint(2 * i - 1, '*'); // Prints decreasing odd number of stars
            System.out.println();
        }
        
    }
    
}

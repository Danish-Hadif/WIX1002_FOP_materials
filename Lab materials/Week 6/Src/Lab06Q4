package week.pkg6;

/**
 Write a Java method that implements Euclidean Algorithm to return the greatest
common divisor of two positive integers. Then, write a program to get the GCD for
(24, 8) and (200, 625).
 */
public class Lab06Q4 {
    public static int gcd(int a, int b){
        while(b!=0){
            int temp = b;
            b = a % b;
            a = temp;
            
        }
        return a;
    }
    public static void main(String[] args) {
        int gcd1 = gcd(24,8);
        System.out.println("GCD of (24, 8) = " + gcd1);
        int gcd2 = gcd(200,625);
        System.out.println("GCD of (200,625) = "+gcd2);
    }
}
